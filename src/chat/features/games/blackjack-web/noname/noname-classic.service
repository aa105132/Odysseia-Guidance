[Unit]
Description=Noname classic private room server
After=docker.service
Requires=docker.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/Odysseia-Guidance/src/chat/features/games/blackjack-web/noname/deploy-launch.py
Restart=always
RestartSec=5
Environment=WS_NO_BUFFER_UTIL=1
Environment=WS_NO_UTF_8_VALIDATE=1
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
